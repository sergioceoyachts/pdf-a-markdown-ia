{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "idiomas",
      "type": "pickString",
      "description": "Idiomas del OCR",
      "options": ["spa+eng", "spa", "eng", "spa+eng+fra", "spa+eng+deu", "spa+eng+ita", "spa+eng+por", "spa+cat+eng"],
      "default": "spa+eng"
    }
  ],
  "tasks": [
    {
      "label": "PDF → Markdown: convertir input/",
      "type": "shell",
      "command": "python3",
      "windows": { "command": ".\\scripts\\ejecutar-python.cmd" },
      "args": ["scripts/pdf_to_md.py", "input/", "--idiomas", "${input:idiomas}"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "PDF → Markdown: sin OCR (rápido)",
      "type": "shell",
      "command": "python3",
      "windows": { "command": ".\\scripts\\ejecutar-python.cmd" },
      "args": ["scripts/pdf_to_md.py", "input/", "--ocr", "no"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "PDF → Markdown: alta resolución + OCR completo + documento completo",
      "type": "shell",
      "command": "python3",
      "windows": { "command": ".\\scripts\\ejecutar-python.cmd" },
      "args": ["scripts/pdf_to_md.py", "input/", "--dpi", "220", "--ocr", "todo", "--completo", "--idiomas", "${input:idiomas}"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Instalar Tesseract OCR (gratis)",
      "type": "shell",
      "command": "winget",
      "args": ["install", "-e", "--id", "UB-Mannheim.TesseractOCR", "--accept-source-agreements", "--accept-package-agreements"],
      "problemMatcher": []
    }
  ]
}
